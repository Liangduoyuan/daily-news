# ── 推送渠道：telegram（默认，有 token 时自动选）或 wecom ──
NEWS_CHANNEL=telegram

# Telegram（推荐）：@BotFather 建 bot 拿 token；chat id 用 @userinfobot 查
NEWS_TELEGRAM_TOKEN=
NEWS_TELEGRAM_CHAT_ID=

# 企业微信群机器人 Webhook（用 wecom 渠道时填）
NEWS_WECOM_WEBHOOK=

# DeepSeek API Key（必填，用于生成中英双语简报）
# https://platform.deepseek.com/api_keys
NEWS_LLM_KEY=
NEWS_LLM_BASE=https://api.deepseek.com
NEWS_LLM_MODEL=deepseek-chat
NEWS_LLM_MAX_TOKENS=4000

# 推送时间（本地时间，逗号分隔）与时区
NEWS_TIMES=08:00,20:00
NEWS_TZ=Asia/Shanghai

# 条数
NEWS_DOMESTIC=5
NEWS_INTERNATIONAL=10

# 简报长度预算（字符）
NEWS_MAX_CHARS=3000

# 只抓最近多少小时的新闻
NEWS_LOOKBACK_HOURS=24

# 1 = 只生成不推送（调试用）
NEWS_DRY_RUN=0
